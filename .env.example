# Supabase Frontend Credentials (somente chave anônima pública)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (Opcional no modo local/offline): Chave da API do TMDB para habilitar busca global direta no frontend
